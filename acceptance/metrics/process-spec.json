  "python_runtime_mapping": [
    {
      "source": "python_gc_objects_collected_total",
      "java": null,
      "supplementary_java": [
        "jvm_gc_collections_total",
        "jvm_gc_collection_seconds_total"
      ],
      "difference": "JVM has no collected-object count equivalent; actual collection events/time are diagnostics, never object counts"
    },
    {
      "source": "python_gc_objects_uncollectable_total",
      "java": null,
      "supplementary_java": [
        "jvm_memory_used_bytes"
      ],
      "difference": "JVM has no uncollectable-object count equivalent; actual used heap/nonheap memory is supplemental, not an object count"
    },
    {
      "source": "python_gc_collections_total",
      "java": "jvm_gc_collections_total",
      "difference": "actual JVM collection count is per collector, not Python generation; jvm_gc_collection_seconds_total additionally reports actual elapsed time"
    },
    {
      "source": "python_info",
      "java": "jvm_info",
      "difference": "actual Java version/vendor/VM; never pretend to be Python version"
    }
  ],
  "http_duration": "from request filter entry to final synchronous/AsyncListener completion including SSE streaming; abort preserves committed status",
  "unobserved_labeled_children": "TYPE registered but no sample/created family until first actual event",
  "creation_metadata": "counter base-total suffix becomes _created; histogram/summary _created; actual child creation system epoch time not business ClockPort"
