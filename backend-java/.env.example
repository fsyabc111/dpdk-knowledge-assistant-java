# backend-java 独立测试环境模板（复制为实际 env 时不得提交）。
# 数据库目标只允许本仓库隔离实例；禁止回退 .env、宿主机默认库或旧部署。
DPDK_JAVA_DB_URL=jdbc:postgresql://127.0.0.1:55481/p1_java_candidate
DPDK_JAVA_DB_USER=p1_java
DPDK_JAVA_DB_PASSWORD=
DPDK_JAVA_DB_NAME=p1_java_candidate
DPDK_JAVA_DB_COMMENT=java-migration-p1-test
DPDK_JAVA_DB_DATA_DIR=/Volumes/study/code/new_project/dpdk-knowledge-assistant-java/.migration-artifacts/p1/pgdata

# 集成测试（三路径迁移）显式启用条件；未设置时 PG 测试显式跳过。
DPDK_TEST_PG_URL=jdbc:postgresql://127.0.0.1:55481/postgres
DPDK_TEST_PG_USER=p1_java
DPDK_TEST_PG_PASSWORD=
DPDK_TEST_PG_DATA_DIR=/Volumes/study/code/new_project/dpdk-knowledge-assistant-java/.migration-artifacts/p1/pgdata
