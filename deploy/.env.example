# Production environment template — copy to deploy/.env and fill in secrets.
# deploy/.env is gitignored; it is injected into containers via env_file and
# never baked into images.

APP_ENV=prod

# ---- PostgreSQL (postgres service) ----
# CHANGE_ME: pick a strong password; it must match DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=assistant
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/assistant
DATABASE_POOL_MAX_SIZE=32

# ---- Knowledge source ----
# The DPDK repo is mounted read-only at /data/dpdk (see docker-compose.yml).
DPDK_REPO_PATH=/data/dpdk
KNOWLEDGE_CONFIG=./data/knowledge_sources.yml

# ---- RAG engine ----
# 唯一检索数据面：版本化 LlamaIndex/pgvector 索引；无 RAG_ENGINE 开关。
RAG_PROVIDER=llama_index
LLAMA_INDEX_TABLE=li_knowledge_v1
LLAMA_INDEX_CONTEXT_WINDOW=16384
LLAMA_INDEX_DB_POOL_SIZE=12
# HNSW 近似向量索引（对照实验用，默认 false = 精确检索）；开启后需执行
# alembic upgrade head 对存量 li 表建索引，见 docs/rag_roadmap.md B1。
LLAMA_INDEX_HNSW_ENABLED=false
LLAMA_INDEX_HNSW_M=16
LLAMA_INDEX_HNSW_EF_CONSTRUCTION=64
LLAMA_INDEX_HNSW_EF_SEARCH=40
# FTS 分词配置（roadmap B2）：默认 simple；zh = zhparser 中文分词，需
# deploy/postgres 自定义镜像（compose 默认），且存量表先执行
# alembic upgrade head（0010）换生成列，否则 ingest 硬失败、FTS 腿降级。
LLAMA_INDEX_FTS_CONFIG=simple
# ---- B3 启发式重排权重：默认值=线上现值，仅调参实验时覆盖（手册见
# docs/runbook.md §10「B3 权重参数扫描」；改动前后各跑一次 runner 对比）。
RETRIEVAL_W_SEMANTIC=0.38
RETRIEVAL_W_LEXICAL=0.24
RETRIEVAL_W_IDENT=0.18
RETRIEVAL_W_LEXICAL_NO_SEMANTIC=0.46
RETRIEVAL_W_IDENT_NO_SEMANTIC=0.26
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_PRIOR_SCALE=14.0
RETRIEVAL_RRF_PRIOR_CAP=0.22
RETRIEVAL_MMR_REDUNDANCY_PENALTY=0.18
RETRIEVAL_MMR_PER_FILE_PENALTY=0.04
RETRIEVAL_MMR_PER_FILE_CAP=2
RETRIEVAL_FILENAME_BOOST_EXACT=0.50
RETRIEVAL_FILENAME_BOOST_PARTIAL=0.30
RETRIEVAL_TOPIC_BOOST_SPECIFIC=0.95
RETRIEVAL_TOPIC_BOOST_GENERIC=0.85
RETRIEVAL_TOPIC_BOOST_SPECIFIC_BARE=0.90
RETRIEVAL_TOPIC_BOOST_GENERIC_BARE=0.80
RETRIEVAL_TOPIC_BOOST_SPECIFIC_INFIX=0.60
RETRIEVAL_TOPIC_BOOST_GENERIC_INFIX=0.50
RETRIEVAL_IDENT_HEADER_SCORE=1.0
RETRIEVAL_IDENT_BODY_SCORE=0.45
RETRIEVAL_DEFINITION_BOOST_TYPEDEF=0.10
RETRIEVAL_DEFINITION_BOOST_FUNCSIG=0.04
RETRIEVAL_STRATEGY=hybrid_fusion_v2
ENABLE_DEBUG_TRACE=false

# ---- LLM / Embedding (DashScope example) ----
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
MODEL_NAME=qwen3.8-flash
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5
# 用量账本（P1）：开关 + 流式 usage 索取 + 模型单价表。
# LLM_PRICES_JSON 留空表示不配价——此时只报用量、cost_micros 为 NULL，不要填猜测值。
LLM_USAGE_RECORDING_ENABLED=true
LLM_STREAM_USAGE_ENABLED=true
LLM_PRICES_JSON=
LLM_PRICE_VERSION=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_SECONDS=1.0

# ---- Conversation memory ----
CONVERSATION_RECENT_TURNS=6
CONVERSATION_SUMMARY_MAX_TOKENS=800
CONVERSATION_SUMMARY_MAX_CHARS=4800
CONVERSATION_MEMORY_MAX_CHARS=24000

# ---- Maintenance endpoint key (X-Maintenance-Key) ----
MAINTENANCE_API_KEY=

# ---- Auth: account mode is required for any non-loopback exposure ----
# account: username/password login (student IDs U2026xxxxxxx, managed via admin UI);
# API_TOKENS_JSON below is kept only as an emergency fallback credential.
# Bootstrap the first admin: docker compose exec backend python scripts/create_user.py --id U20260000001 --roles admin
AUTH_MODE=account
AUTH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=8
# bcrypt cost factor for password hashing; the test suite forces 4 via conftest,
# do not lower this in production.
BCRYPT_ROUNDS=12
# Emergency fallback token (>=32 chars), e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKENS_JSON={"CHANGE_ME_TOKEN_32_CHARS_MIN_aaaaaaaaaaaaaaaaaaaa": {"subject": "admin", "roles": ["admin"], "daily_quota": 0}}
RATE_LIMIT_CHAT_PER_MINUTE=20
LLM_DAILY_QUOTA_DEFAULT=200

# Sessions idle longer than this (by updated_at) are purge-eligible.
SESSION_RETENTION_DAYS=30

# Same-origin behind nginx; CORS allowlist is unused but kept explicit.
FRONTEND_ORIGINS=

# ---- harness service (docker-compose.yml) ----
# teaching_harness 独立仓库的父目录；compose 构建上下文为
# ${TEACHING_HARNESS_PATH}/teaching_harness，默认 ../..（即 E:\teaching_harness）。
# 注意：${} 插值读取的是 compose 项目根的 .env 或 shell 环境；本文件仅经
# env_file 注入容器。要用本文件的值，启动时加 --env-file deploy/.env。
# TEACHING_HARNESS_PATH=../..

# ---- Logging: JSON to stdout (collected by Docker); leave LOG_FILE empty ----
LOG_LEVEL=INFO
LOG_FILE=
# 产品化问答是唯一路径（S4 收敛，无开关）：需 migration 0008 + 一次版本索引
# 发布后才就绪；单 backend worker。
RAG_VALIDATION_TIMEOUT_SEC=20
RAG_REQUEST_TIMEOUT_SEC=120
# 受理阶段（重放探测、会话登记、写请求行）整体超时
RAG_PREPARE_TIMEOUT_SEC=15
RAG_MAX_ACTIVE_REQUESTS=20
RAG_MAX_WAITING_REQUESTS=20
RAG_QUEUE_TIMEOUT_SEC=10
RAG_UPSTREAM_CONCURRENCY=20
RAG_RETENTION_DAYS=180
RAG_CONTEXT_MAX_CHARS=24000
RAG_REQUEST_TOKEN_BUDGET=48000
RAG_ANSWER_CACHE_ENABLED=false
# N08：在线模型 judge 默认关闭，每次回答只跑确定性检查（空答案/引用越界/
# 无证据/缺引用）；模型核验走离线评估 scripts/rag_judge_eval.py。
# 置 true 恢复逐请求在线核验。
RAG_ONLINE_JUDGE_ENABLED=false
# ---- S3 任务持久化/恢复护栏（docs/decisions.md §8）----
# 单任务后台执行硬时限（秒，冻结值 10 分钟）；超时按取消语义终止。
RAG_TASK_MAX_SECONDS=600
# 任务执行输入（原始问题 + 寄存源码）兜底留存小时数；任务终止即清理，此为上限。
RAG_TASK_INPUT_TTL_HOURS=24
