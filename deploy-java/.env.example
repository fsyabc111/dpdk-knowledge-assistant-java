# 复制到 .migration-artifacts/java-isolated.env，自行填写；禁止复用旧 .env。
DPDK_JAVA_DB_PASSWORD=replace-with-new-isolated-password
DPDK_JAVA_HTTPS_PORT=18443
DPDK_JAVA_AUTH_MODE=account
DPDK_JAVA_MODEL_JUDGE_ENABLED=false
# 必须是绝对路径；目录内容只有获准的合成/脱敏源。
DPDK_JAVA_SOURCE_SNAPSHOT_DIR=/absolute/path/to/synthetic-sources
DPDK_JAVA_CERT_DIR=/absolute/path/to/java-isolated-certs
# 与证书所有者一致的非root UID/GID（id -u / id -g）；禁止填0。
DPDK_JAVA_PROXY_UID=1000
DPDK_JAVA_PROXY_GID=1000
# 本地CLI ingest所用四个显式路径（Compose容器内已固定为/sources/...）。
# CLI由调用者逐项export；不要把本文件source到旧服务。
DPDK_JAVA_KNOWLEDGE_CONFIG=/absolute/path/to/synthetic-sources/knowledge_sources.yml
DPDK_JAVA_DPDK_ROOT=/absolute/path/to/synthetic-sources/dpdk
DPDK_JAVA_ASSISTANT_ROOT=/absolute/path/to/synthetic-sources/assistant
DPDK_JAVA_INDEX_WORKING_DIRECTORY=/absolute/path/to/synthetic-sources
