# 独立前端镜像；仅向 Java /api/ 反代。
FROM node@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS builder
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE=""
RUN npm run build
FROM nginxinc/nginx-unprivileged@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy-java/nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8443
USER 101:101
