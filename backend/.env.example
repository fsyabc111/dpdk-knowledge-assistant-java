APP_ENV=dev
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8090
# Default runtime: local PostgreSQL + pgvector (Homebrew socket connection).
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql:///assistant
DATABASE_POOL_MAX_SIZE=32
# Explicit SQLite fallback for isolated development only:
# DATABASE_BACKEND=sqlite
# DATABASE_URL=sqlite:///./data/assistant.db
# Paths auto-discover from this checkout by default. Override them on Linux
# when the DPDK repository and assistant project live elsewhere.
# DPDK_REPO_PATH=/opt/dpdk
# ASSISTANT_PROJECT_PATH=/opt/dpdk/ai_chat_assistant
KNOWLEDGE_CONFIG=./data/knowledge_sources.yml
# 唯一检索数据面：LlamaIndex pgvector 语义召回 + DPDK 专有 FTS/路径/符号融合。
# 旧 RAG_ENGINE 开关与 legacy 数据面已删除；knowledge_chunks 仅回读历史引用。
RAG_PROVIDER=llama_index
LLAMA_INDEX_TABLE=li_knowledge_v1
# Larger than LlamaIndex's conservative 3900-token default: the configured
# OpenAI-compatible model supports a full grounded context in one response.
LLAMA_INDEX_CONTEXT_WINDOW=16384
LLAMA_INDEX_DB_POOL_SIZE=12
# HNSW 近似向量索引（对照实验用，默认 false = 精确检索）；开启后需执行
# alembic upgrade head 对存量 li 表建索引，见 docs/rag_roadmap.md B1。
LLAMA_INDEX_HNSW_ENABLED=false
LLAMA_INDEX_HNSW_M=16
LLAMA_INDEX_HNSW_EF_CONSTRUCTION=64
LLAMA_INDEX_HNSW_EF_SEARCH=40
# FTS 分词配置（roadmap B2）：默认 simple；zh = zhparser 中文分词，需
# deploy/postgres 自定义镜像，且存量表先执行 alembic upgrade head（0010）
# 换生成列，否则 ingest 硬失败、FTS 腿降级并告警。
LLAMA_INDEX_FTS_CONFIG=simple
# ---- B3 启发式重排权重：默认值=线上现值，仅调参实验时覆盖（手册见
# docs/runbook.md §10「B3 权重参数扫描」；改动前后各跑一次 runner 对比）。
RETRIEVAL_W_SEMANTIC=0.38
RETRIEVAL_W_LEXICAL=0.24
RETRIEVAL_W_IDENT=0.18
RETRIEVAL_W_LEXICAL_NO_SEMANTIC=0.46
RETRIEVAL_W_IDENT_NO_SEMANTIC=0.26
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_PRIOR_SCALE=14.0
RETRIEVAL_RRF_PRIOR_CAP=0.22
RETRIEVAL_MMR_REDUNDANCY_PENALTY=0.18
RETRIEVAL_MMR_PER_FILE_PENALTY=0.04
RETRIEVAL_MMR_PER_FILE_CAP=2
RETRIEVAL_FILENAME_BOOST_EXACT=0.50
RETRIEVAL_FILENAME_BOOST_PARTIAL=0.30
RETRIEVAL_TOPIC_BOOST_SPECIFIC=0.95
RETRIEVAL_TOPIC_BOOST_GENERIC=0.85
RETRIEVAL_TOPIC_BOOST_SPECIFIC_BARE=0.90
RETRIEVAL_TOPIC_BOOST_GENERIC_BARE=0.80
RETRIEVAL_TOPIC_BOOST_SPECIFIC_INFIX=0.60
RETRIEVAL_TOPIC_BOOST_GENERIC_INFIX=0.50
RETRIEVAL_IDENT_HEADER_SCORE=1.0
RETRIEVAL_IDENT_BODY_SCORE=0.45
RETRIEVAL_DEFINITION_BOOST_TYPEDEF=0.10
RETRIEVAL_DEFINITION_BOOST_FUNCSIG=0.04
RETRIEVAL_STRATEGY=hybrid_fusion_v2
ENABLE_DEBUG_TRACE=false
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
MODEL_NAME=qwen3.8-flash
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5
# ---- 用量与成本（P1）----
# 上游用量账本总开关。关闭后不再写 upstream_usage_records，trace 里的聚合仍在。
LLM_USAGE_RECORDING_ENABLED=true
# 流式请求是否索取 usage 尾帧（stream_options.include_usage）。上游若不支持，
# 会自动去掉该字段重试一次并记为未知用量，但每次多花一个 RTT，故单独留开关。
LLM_STREAM_USAGE_ENABLED=true
# 模型单价表。单价必须写成字符串以便精确十进制解析；留空是合法状态——
# 此时只报用量、不出价（cost_micros 为 NULL），不要填猜测值。
# 未在此表中的模型同样只报用量。
# LLM_PRICES_JSON={"qwen3.8-flash":{"input_per_1k":"0.0008","output_per_1k":"0.002","currency":"CNY"},"text-embedding-v4":{"input_per_1k":"0.0005","currency":"CNY"}}
LLM_PRICES_JSON=
# 价格来源/生效标识，随每条记录落库；日后调价不回溯改历史账。
LLM_PRICE_VERSION=
# Keep the newest N user/assistant exchanges verbatim. Older exchanges are
# compacted into a session summary stored in the database.
CONVERSATION_RECENT_TURNS=6
CONVERSATION_SUMMARY_MAX_TOKENS=800
# Hard limits enforced by the server even if a model ignores its prompt.
CONVERSATION_SUMMARY_MAX_CHARS=4800
CONVERSATION_MEMORY_MAX_CHARS=24000
# Protects read-only maintenance endpoints. Do not expose this value to the
# frontend; use it as X-Maintenance-Key when checking session storage.
MAINTENANCE_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_SECONDS=1.0
FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Authentication: "local" = no credentials (loopback development only);
# "token" = require Authorization: Bearer <token> on chat endpoints.
AUTH_MODE=local
# bcrypt cost factor for password hashing (account mode). Default 12;
# the test suite forces 4 via conftest — do not lower this in production.
BCRYPT_ROUNDS=12
# Token map: {"<token (>=32 chars)>": {"subject": "alice", "roles": ["viewer"], "daily_quota": 50}}
# roles is a non-empty subset of ["viewer", "operator", "admin"]; daily_quota
# defaults to LLM_DAILY_QUOTA_DEFAULT when omitted; 0 means unlimited.
API_TOKENS_JSON={}
# Per-subject chat rate limit and default daily LLM quota.
RATE_LIMIT_CHAT_PER_MINUTE=20
LLM_DAILY_QUOTA_DEFAULT=200
# ---- Agent (M1): LangGraph 助教编排 + harness MCP 评测 ----
# S4 起编排层是唯一问答路径，无 AGENT_ENABLED 开关。
# 单次请求的工具调用循环硬上限。
AGENT_MAX_TOOL_ROUNDS=5
# agent 编排层 LLM 单次响应的 max_tokens：评测调用要在单次响应里输出完整
# plugin_source 工具参数（可达 3-4K+ tokens），沿用 LLM_MAX_TOKENS=2048 会把
# 参数截断成残码导致编译失败，勿低于 4096。生产部署若遇评测编译失败首先检查此值。
AGENT_LLM_MAX_TOKENS=8192
# teaching_harness 容器的 MCP streamable HTTP 端点（compose 内网地址）。
HARNESS_MCP_URL=http://harness:8100/mcp
# 单次评测后端硬超时（秒）/ 代码大小上限（字节，256 KB）/ 学生日评测配额
#（operator 角色豁免）。
GRADING_TIMEOUT_SEC=120
GRADING_MAX_CODE_BYTES=262144
GRADING_DAILY_QUOTA=20
# 分级反馈：同一协议累计 FAIL 达此阈值可升级为定位级建议；
# ALLOW_EXPLICIT_ASK 控制"学生明确要求"这一升级条件是否生效。
FEEDBACK_ESCALATION_THRESHOLD=3
FEEDBACK_ALLOW_EXPLICIT_ASK=true
# M2 参考答案注入：评测出现非 PASS 用例时带外拉取教师参考实现追加进系统
# 提示词（仅供模型理解错因，红线禁止转述），此为注入源码的字符上限。
REFERENCE_ANSWER_MAX_CHARS=20000
# Sessions idle longer than this (by updated_at) are purge-eligible via
# scripts/purge_sessions.py or POST /api/internal/purge-sessions.
SESSION_RETENTION_DAYS=30
# Unified JSON logging: stdout is always active; set LOG_FILE to also write a
# rotating file (containers should leave LOG_FILE empty and collect stdout).
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5
# RAG 产品化是唯一问答路径（S4 收敛，无开关）；需要先完成 migration 0008
# 和一次版本化索引发布（scripts/ingest_llama_index.py），否则 /api/ready 报 503。
RAG_VALIDATION_TIMEOUT_SEC=20
RAG_REQUEST_TIMEOUT_SEC=120
# 受理阶段（重放探测、会话登记、写请求行）整体超时
RAG_PREPARE_TIMEOUT_SEC=15
RAG_MAX_ACTIVE_REQUESTS=20
RAG_MAX_WAITING_REQUESTS=20
RAG_QUEUE_TIMEOUT_SEC=10
RAG_UPSTREAM_CONCURRENCY=20
RAG_RETENTION_DAYS=180
RAG_CONTEXT_MAX_CHARS=24000
RAG_REQUEST_TOKEN_BUDGET=48000
RAG_ANSWER_CACHE_ENABLED=false
# N08：在线模型 judge 默认关闭，每次回答只跑确定性检查（空答案/引用越界/
# 无证据/缺引用）；模型核验走离线评估 scripts/rag_judge_eval.py。
# 置 true 恢复逐请求在线核验。
RAG_ONLINE_JUDGE_ENABLED=false
# ---- S3 任务持久化/恢复护栏（docs/decisions.md §8）----
# 单任务后台执行硬时限（秒，冻结值 10 分钟）；超时按取消语义终止。
RAG_TASK_MAX_SECONDS=600
# 任务执行输入（原始问题 + 寄存源码）兜底留存小时数；任务终止即清理，此为上限。
RAG_TASK_INPUT_TTL_HOURS=24
